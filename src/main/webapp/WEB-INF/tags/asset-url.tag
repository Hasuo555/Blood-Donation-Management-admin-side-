<%@ tag trimDirectiveWhitespaces="true" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ attribute name="value" required="true" rtexprvalue="true" %>
<c:choose><c:when test="${empty value}"><c:url var="resolvedAssetUrl" value="/static/images/placeholder.svg"/></c:when><c:when test="${not empty assetResolver}"><c:set var="resolvedAssetUrl" value="${assetResolver.getPublicOrSignedUrl(value)}"/></c:when><c:when test="${fn:startsWith(value, 'http://') or fn:startsWith(value, 'https://') or fn:startsWith(value, '//') or fn:startsWith(value, 'data:')}"><c:set var="resolvedAssetUrl" value="${value}"/></c:when><c:otherwise><c:set var="normalizedAssetPath" value="${value}"/><c:if test="${not fn:startsWith(normalizedAssetPath, '/')}"><c:set var="normalizedAssetPath" value="/${normalizedAssetPath}"/></c:if><c:url var="resolvedAssetUrl" value="${normalizedAssetPath}"/></c:otherwise></c:choose><c:if test="${fn:startsWith(resolvedAssetUrl, '/') and not fn:startsWith(resolvedAssetUrl, '//')}"><c:url var="contextAwareAssetUrl" value="${resolvedAssetUrl}"/></c:if><c:choose><c:when test="${not empty contextAwareAssetUrl}"><c:out value="${contextAwareAssetUrl}" escapeXml="true"/></c:when><c:otherwise><c:out value="${resolvedAssetUrl}" escapeXml="true"/></c:otherwise></c:choose>
